{
  "name": "quixseo",
  "version": "0.1.0-alpha.1",
  "description": "QuixSEO \u2014 Complete SEO Toolkit for EmDash",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Webtaculos",
    "url": "https://webtaculos.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "vitest run --config vitest.config.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "build": "emdash-plugin build",
    "validate": "emdash-plugin validate",
    "bundle": "emdash-plugin bundle",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate && npm run build",
    "dev:site": "astro dev --root test-site",
    "test:imports": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@biomejs/biome": "2.4.6",
    "@emdash-cms/blocks": "1.3.1",
    "@emdash-cms/plugin-cli": "0.13.4",
    "@emdash-cms/plugin-test": "0.2.10",
    "@emdash-cms/sandbox-workerd": "0.9.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "24.10.1",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.0"
  },
  "imports": { "#validation": "zod/mini" },
  "exports": {
    ".": "./dist/index.mjs",
    "./sandbox": "./dist/plugin.mjs"
  },
  "files": [
    "dist",
    "emdash-plugin.jsonc",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "THIRD-PARTY-LICENSES.txt"
  ]
}
