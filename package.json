{
  "name": "quixseo",
  "version": "0.0.2",
  "description": "QuixSEO — Complete SEO Toolkit for EmDash · EmQuix",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "EmQuix",
    "url": "https://emquix.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "vitest run --config vitest.config.ts",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "build": "emdash-plugin build",
    "validate": "emdash-plugin validate",
    "bundle": "emdash-plugin bundle",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate && npm run build",
    "dev:site": "astro dev --root test-site",
    "test:imports": "node scripts/test-imports.mjs",
    "test:browser": "node tests/browser/regressions.mjs",
    "test:browser:llms": "node tests/browser/llms.mjs",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@biomejs/biome": "2.4.6",
    "@emdash-cms/blocks": "1.4.0",
    "@emdash-cms/plugin-cli": "0.13.5",
    "@emdash-cms/plugin-test": "0.2.11",
    "@emdash-cms/sandbox-workerd": "0.9.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "24.10.1",
    "astro": "7.4.2",
    "emdash": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "zod@^4.0.0": "$zod",
    "undici@^7.0.0": "7.30.1",
    "sharp@^0.35.0": "0.35.5"
  },
  "imports": {
    "#validation": "zod/mini"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./sandbox": "./dist/plugin.mjs"
  },
  "files": [
    "icon.png",
    "dist",
    "emdash-plugin.jsonc",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "THIRD-PARTY-LICENSES.txt"
  ]
}
